---
import Head from "../components/Head.astro";
interface Props {
  title: string;
  description: string;
}

const { title } = Astro.props;
const { description } = Astro.props;

import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} author="Datonic" />
  </head>
  <body>
    <slot />
  </body>
</html>
