---
import Layout from "../layouts/Base.astro";

const projects = [
  {
    name: "About",
    href: "/about",
    description:
      "How Datonic works, how you can collaborate, and what we believe about Open Data.",
  },
  {
    name: "Datadex",
    href: "https://datadex.datonic.io",
    description:
      "An open source, serverless, and local-first Data Platform pattern to help communities collaborate on Open Data.",
  },
  {
    name: "Hub",
    href: "https://github.com/datonic/hub",
    description:
      "The place to discuss how to do Open Data with open protocols running on open infrastructure.",
  },
  {
    name: "Open Data notes",
    href: "https://davidgasquez.com/handbook/open-data",
    description:
      "Raw notes on how Open Data creates open knowledge and how we can improve the current ecosystem.",
  },
];
---

<Layout
  title="Datonic"
  description="The best place for communities to collaborate on data. Create, curate, and share datasets with the world."
>
  <h1 class="lede">
    The best place for communities to collaborate on data. Create, curate, and
    share datasets with the world.
  </h1>

  <ul class="entries">
    {
      projects.map((project) => (
        <li>
          <h2>
            <a href={project.href}>{project.name}</a>
          </h2>
          <p>{project.description}</p>
        </li>
      ))
    }
  </ul>
</Layout>
